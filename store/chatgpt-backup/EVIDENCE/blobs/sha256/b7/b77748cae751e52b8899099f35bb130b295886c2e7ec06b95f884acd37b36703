alkingCapture\")\n\nfunction finish(result) {\n  Script.setShortcutOutput(result)\n  Script.complete()\n}\n\nfunction pad(n) {\n  return n < 10 ? \"0\" + n : String(n)\n}\n\nfunction uuid4() {\n  const hex = \"0123456789abcdef\"\n  let s = \"\"\n\n  for (let i = 0; i < 36; i++) {\n    if (i === 8 || i === 13 || i === 18 || i === 23) {\n      s += \"-\"\n    } else if (i === 14) {\n      s += \"4\"\n    } else if (i === 19) {\n      s += \"89ab\"[Math.floor(Math.random() * 4)]\n    } else {\n      s += hex[Math.floor(Math.random() * 16)]\n    }\n  }\n\n  return s\n}\n\nfunction isoLocal(d) {\n  const off = d.getTimezoneOffset()\n  const sign = off <= 0 ? \"+\" : \"-\"\n  const a = Math.abs(off)\n\n  return (\n    d.getFullYear() + \"-\" +\n    pad(d.getMonth() + 1) + \"-\" +\n    pad(d.getDate()) + \"T\" +\n    pad(d.getHours()) + \":\" +\n    pad(d.getMinutes()) + \":\" +\n    pad(d.getSeconds()) +\n    sign +\n    pad(Math.floor(a / 60)) + \":\" +\n    pad(a % 60)\n  )\n}\n\nfunction timezoneName() {\n  try {\n    return Intl.DateTimeFormat().resolvedOptions().timeZone || null\n  } catch (e) {\n    return null\n  }\n}\n\nfunction getPackedInput() {\n  const p = args.shortcutParameter\n\n  // Older/simple Shortcut input\n  if (typeof p === \"string\") {\n    return p\n  }\n\n  if (!p || typeof p !== \"object\") {\n    return \"\"\n  }\n\n  // Current Scriptable/Shortcuts structured input.\n  // Accept several possible key casings/shapes so we don't fight iOS UI changes.\n  const possibleArrays = [\n    p.texts,\n    p.Texts,\n    p.text,\n    p.Text\n  ]\n\n  for (const value of possibleArrays) {\n    if (Array.isArray(value) && value.length > 0) {\n      return String(value[0])\n    }\n\n    if (typeof value === \"string\") {\n      return value\n    }\n  }\n\n  return \"\"\n}\n\ntry {\n  const packed = getPackedInput()\n\n  if (!packed || packed.trim().length === 0) {\n    finish(\"cancelled\")\n    return\n  }\n\n  const nl = packed.indexOf(\"\\n\")\n\n  const trigger =\n    (nl === -1 ? packed : packed.slice(0, nl)).trim() || \"unknown\"\n\n  const rawText =\n    nl === -1 ? \"\" : packed.slice(nl + 1)\n\n  if (rawText.trim().length === 0) {\n    finish(\"cancelled\")\n    return\n  }\n\n  const now = new Date()\n  const captureId = uuid4()\n\n  const envelope = {\n    capture_id: captureId,\n    captured_at: isoLocal(now),\n    source: \"iphone\",\n    capture_type: \"voice\",\n    raw_text: rawText,\n    timezone: timezoneName(),\n    trigger: trigger,\n    schema_version: \"0.1\"\n  }\n\n  const day =\n    now.getFullYear() + \"-\" +\n    pad(now.getMonth() + 1) + \"-\" +\n    pad(now.getDate())\n\n  const dayDir = FM.joinPath(ROOT, day)\n\n  if (!FM.isDirectory(dayDir)) {\n    FM.createDirectory(dayDir, true)\n  }\n\n  const path = FM.joinPath(dayDir, captureId + \".json\")\n\n  // Immutable capture: never overwrite.\n  if (FM.fileExists(path)) {\n    finish(\"fail\")\n    return\n  }\n\n  FM.writeString(path, JSON.stringify(envelope, null, 2))\n\n  if (!FM.fileExists(path)) {\n    finish(\"fail\")\n    return\n  }\n\n  finish(\"ok\")\n  return\n\n} catch (e) {\n  finish(\"fail\")\n  return\n}\n```\n\nNow **leave the Shortcut alone except for one thing**:\n\nIn your Scriptable action:\n\n**Run `GCE_Capture` → Texts → Add New Item → select the yellow `Text` variable.**\n\nThat yellow Text block already contains:\n\n```text\naction_button\n[Dictated Text]\n```\n\nNo more messing with the top-level `Parameter` field.\n\nAnd yes, I know the red Siri error is sitting there screaming at us. **Ignore it for this step.** First we get the Scriptable handoff wired. Then we solve dictation execution separately."]}, "create_time": 1790133568.034637, "end_turn": true, "id": "f0e0f7f5-ad45-40d9-a584-378d202fc3a5", "metadata": {"can_save": true, "citations": [], "code_blocks": {"0": {"edited": false, "id": "71c3yy", "preview_language": null, "previewable": false}, "1": {"edited": false, "id": "j6rzad", "preview_language": null, "prev