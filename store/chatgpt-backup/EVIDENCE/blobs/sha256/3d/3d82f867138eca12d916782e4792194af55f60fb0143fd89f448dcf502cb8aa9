hentication/model discovery ⏳**."]}, "create_time": 1790215701.868528, "end_turn": true, "id": "bc4257ce-6acc-4578-a87b-ff31a448b366", "metadata": {"can_save": true, "citations": [], "code_blocks": {"0": {"edited": false, "id": "f47pfe", "preview_language": null, "previewable": false}}, "content_references": [{"alt": "([AWS Documentation](https://docs.aws.amazon.com/us_en/bedrock/latest/userguide/models-get-info.html?utm_source=chatgpt.com))", "end_idx": 377, "error": null, "fallback_items": null, "items": [{"attribution": "AWS Documentation", "attribution_segments": null, "attributions": null, "hue": null, "pub_date": null, "refs": [{"ref_index": 0, "ref_type": "search", "turn_index": 0}, {"ref_index": 4, "ref_type": "search", "turn_index": 0}], "snippet": "", "supporting_websites": [{"attribution": "AWS Documentation", "pub_date": null, "snippet": "", "title": "Chat Completions API - Amazon Bedrock", "url": "https://docs.aws.amazon.com/bedrock/latest/userguide/inference-chat-completions.html?utm_source=chatgpt.com"}], "title": "Get list of models - Amazon Bedrock", "url": "https://docs.aws.amazon.com/us_en/bedrock/latest/userguide/models-get-info.html?utm_source=chatgpt.com"}], "matched_text": "citeturn777963search0turn777963search4", "prefix": null, "prompt_text": null, "refs": [], "safe_urls": ["https://docs.aws.amazon.com/bedrock/latest/userguide/inference-chat-completions.html", "https://docs.aws.amazon.com/bedrock/latest/userguide/inference-chat-completions.html?utm_source=chatgpt.com", "https://docs.aws.amazon.com/us_en/bedrock/latest/userguide/models-get-info.html", "https://docs.aws.amazon.com/us_en/bedrock/latest/userguide/models-get-info.html?utm_source=chatgpt.com"], "start_idx": 335, "status": "done", "style": null, "type": "grouped_webpages"}, {"alt": "", "end_idx": 1170, "has_images": false, "matched_text": " ", "prefix": null, "prompt_text": null, "refs": [], "safe_urls": [], "sources": [{"attribution": "AWS Documentation", "title": "Get list of